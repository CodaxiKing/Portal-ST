# Caddy serve o site com HTTPS automático. Troque pelo seu domínio.
portal.seudominio.com {
	root * /var/www/shoptitans
	encode zstd gzip

	# Robôs de IA e de raspagem: o robots.txt pede para não entrarem; aqui eles são barrados de fato (403),
	# menos no próprio robots.txt. Buscadores normais (Google, Bing) continuam liberados.
	@bots {
		header_regexp User-Agent (?i)(gptbot|chatgpt-user|oai-searchbot|claudebot|claude-user|claude-searchbot|anthropic-ai|ccbot|google-extended|perplexitybot|perplexity-user|bytespider|amazonbot|applebot-extended|meta-externalagent|meta-webindexer|facebookbot|cohere-ai|diffbot|imagesiftbot|omgilibot|timpibot|youbot|mj12bot|ahrefsbot|semrushbot|dotbot|dataforseobot|petalbot|python-requests|scrapy|httpclient|go-http-client|curl|wget)
		not path /robots.txt
	}
	respond @bots 403

	header X-Robots-Tag "noai, noimageai"
	file_server
	@data path /data/* /img/* /og/*
	header @data Cache-Control "public, max-age=3600"
}
